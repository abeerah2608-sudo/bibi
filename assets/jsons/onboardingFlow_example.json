          "id": "content_card",
          "type": "card",
          "content": {
            "translations": {
              "English": "[b]Early Detection[/b] Saves Lives\n\nRegular screening and awareness can detect breast cancer early, when treatment is most effective.",
              "اردو": "[b]جلد شناخت[/b] زندگیاں بچاتی ہے\n\nباقاعدہ اسکریننگ اور شعور سے سینے کے کینسر کی جلد شناخت ممکن ہے۔",
              "Roman Urdu": "[b]Jald Shanaakht[/b] Zindagiyaan Bachati Hain\n\nBaqa'idah screening aur shuoor se sene ke cancer ki jald shanaakht mumkin hai."
            }
          },
          "position": {
            "alignment": "center",
            "padding": {
              "all": 16,
              "horizontal": 12
            },
            "width": 300,
            "margin": {
              "horizontal": 12
            }
